# Compatibility entrypoint for existing ~/.zshrc links and manual sourcing.
# Normal startup uses ~/.zshenv to redirect Zsh into its XDG directory.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
[[ ! -r "$ZDOTDIR/.zshenv" ]] || source "$ZDOTDIR/.zshenv"
[[ ! -r "$ZDOTDIR/.zshrc" ]] || source "$ZDOTDIR/.zshrc"

# Shared SSH agent for local terminal sessions
if [[ -z "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi
