# Konsole color scheme only; select Moon in the terminal profile to apply it.
# Color values are decimal RGB; Color0 through Color7 are the standard ANSI colors.
[General]
Description=Tokyonight Moon
Opacity=1
# Base background and foreground are separate from the ANSI palette.
[Background]
Color=34,36,54
[Foreground]
Color=200,211,245
# ANSI order: black, red, green, yellow, blue, magenta, cyan, white.
[Color0]
Color=27,29,43
[Color1]
Color=255,117,127
[Color2]
Color=195,232,141
[Color3]
Color=255,199,119
[Color4]
Color=130,170,255
[Color5]
Color=192,153,255
[Color6]
Color=134,225,252
[Color7]
Color=200,211,245
